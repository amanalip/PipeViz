# ---------------------------------------------------------------------------
# .gitignore - things that must never reach version control
# ---------------------------------------------------------------------------

# Dependencies: reproducible from package.json via `npm ci`.
node_modules/

# Build output: regenerated by `npm run build` and uploaded fresh by CI.
dist/

# Local env dumps; PipeViz has no backend secrets but keep hygiene anyway.
.env
.env.*
!.env.example

# Editor state folders.
.vscode/
.idea/

# OS noise.
.DS_Store
Thumbs.db

# Test and coverage artifacts.
coverage/
*.tsbuildinfo

# npm debug logs from failed installs.
npm-debug.log*

# Playwright failure artifacts
test-results/
